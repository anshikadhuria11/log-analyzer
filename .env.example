# Environment variables (leave values empty for demo mode)
# LLM provider: groq, google, or fake
LLM_PROVIDER=groq
# Model ID (must be a free-tier model)
LLM_MODEL=llama-3.3-70b-versatile
# API keys (optional for fake provider)
GROQ_API_KEY=
GOOGLE_API_KEY=
# Prompt and input limits
PROMPT_MAX_CHARS=24000
LLM_RATE_LIMIT_WAIT_MAX_SECONDS=20
MAX_INPUT_CHARS=200000
MAX_ANALYSIS_LINES=300
TOP_PATTERNS=15
CONTEXT_LINES=5
RAW_MODE_MAX_CHARS=24000
RATE_LIMIT_PER_10MIN=10
# History (DynamoDB) settings
ENABLE_HISTORY=false
DYNAMODB_TABLE=log_analyses
DYNAMODB_ENDPOINT_URL=
APP_AWS_REGION=ap-south-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=log-analyzer
# CORS (dev) origins
CORS_ORIGINS=http://localhost:5173
